# =========================
# FONT
# =========================
font_family JetBrainsMono Nerd Font
bold_font auto
italic_font auto
bold_italic_font auto
font_size 12.0

# =========================
# WINDOW
# =========================
window_padding_width 12
window_border_width 0
background_opacity 0.90
confirm_os_window_close 0

# =========================
# CURSOR
# =========================
cursor_shape block
cursor_blink_interval 0.5
cursor_stop_blinking_after 15

# =========================
# SCROLLBACK
# =========================
scrollback_lines 10000
wheel_scroll_multiplier 5.0

# =========================
# PERFORMANCE
# =========================
enable_audio_bell no
repaint_delay 10
input_delay 3
sync_to_monitor yes

# =========================
# COLORS (Catppuccin Mocha)
# =========================

# Base
foreground #CDD6F4   # Text (light foreground)
background #1E1E2E   # Base (main background)

# Selection
selection_foreground #1E1E2E   # Base
selection_background #F5E0DC   # Rosewater

# Black
color0  #45475A   # Surface1
color8  #585B70   # Surface2

# Red
color1  #F38BA8   # Red
color9  #F38BA8   # Bright Red

# Green
color2  #A6E3A1   # Green
color10 #A6E3A1   # Bright Green

# Yellow
color3  #F9E2AF   # Yellow
color11 #F9E2AF   # Bright Yellow

# Blue
color4  #89B4FA   # Blue
color12 #89B4FA   # Bright Blue

# Magenta
color5  #CBA6F7   # Mauve
color13 #CBA6F7   # Bright Mauve

# Cyan
color6  #94E2D5   # Teal
color14 #94E2D5   # Bright Teal

# White
color7  #BAC2DE   # Subtext1
color15 #A6ADC8   # Subtext0

# =========================
# TABS
# =========================
tab_bar_edge bottom
tab_bar_style powerline
tab_powerline_style angled

active_tab_background   #89B4FA   # Blue
active_tab_foreground   #1E1E2E   # Base

inactive_tab_background #313244   # Surface0
inactive_tab_foreground #CDD6F4   # Text

# =========================
# KEYBINDS (POWER USER)
# =========================

# New terminals
map ctrl+enter new_window
map ctrl+shift+enter new_os_window

# Navigation (vim-style)
map ctrl+shift+h neighboring_window left
map ctrl+shift+l neighboring_window right
map ctrl+shift+k neighboring_window up
map ctrl+shift+j neighboring_window down
map ctrl+shift+e kitten hints
map ctrl+shift+o set_background_opacity 0.85
map ctrl+shift+i kitten icat
# =========================
# CLIPBOARD
# =========================
copy_on_select yes

# =========================
# EXTRAS
# =========================
allow_remote_control no
shell_integration enabled
